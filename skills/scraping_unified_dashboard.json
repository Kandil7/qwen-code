{
  "dashboard": {
    "title": "Unified Scraping Monitoring Dashboard",
    "description": "Combined metrics from Scrapling, Firecrawl, and Scrapy",
    "tags": ["scraping", "scrapling", "firecrawl", "scrapy"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Overall Success Rate (All Frameworks)",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Scraping Success Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
        "targets": [
          {"expr": "scraper_success_rate_percent{framework=\"scrapling\"}", "legendFormat": "Scrapling"},
          {"expr": "scraper_success_rate_percent{framework=\"firecrawl\"}", "legendFormat": "Firecrawl"},
          {"expr": "scraper_success_rate_percent{framework=\"scrapy\"}", "legendFormat": "Scrapy"}
        ],
        "thresholds": [
          {"value": 95, "color": "green"},
          {"value": 80, "color": "yellow"},
          {"value": 0, "color": "red"}
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent"
          }
        }
      },
      {
        "id": 3,
        "title": "Total Items Extracted",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
        "targets": [
          {"expr": "sum(scraper_items_extracted_total)", "legendFormat": "Total"}
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}]}
          }
        }
      },
      {
        "id": 4,
        "title": "Total Cost (Firecrawl)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
        "targets": [
          {"expr": "firecrawl_total_cost_usd", "legendFormat": "USD"}
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 5,
        "title": "Data Quality Score",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 5},
        "targets": [
          {"expr": "scraper_data_quality_score", "legendFormat": "Quality %"}
        ],
        "thresholds": [
          {"value": 90, "color": "green"},
          {"value": 70, "color": "yellow"},
          {"value": 0, "color": "red"}
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent"
          }
        }
      },
      {
        "id": 6,
        "title": "Active Alerts",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 5},
        "targets": [
          {"expr": "scraper_active_alerts", "legendFormat": "Alerts"}
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]}
          }
        }
      },
      {
        "id": 7,
        "title": "Items Extracted Over Time (By Framework)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
        "targets": [
          {"expr": "rate(scraper_items_extracted_total{framework=\"scrapling\"}[5m])", "legendFormat": "Scrapling"},
          {"expr": "rate(firecrawl_pages_extracted_total[5m])", "legendFormat": "Firecrawl"},
          {"expr": "rate(scrapy_items_scraped_total[5m])", "legendFormat": "Scrapy"}
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "items/sec"
          }
        }
      },
      {
        "id": 8,
        "title": "Request Latency (P95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
        "targets": [
          {"expr": "histogram_quantile(0.95, scraper_request_duration_seconds_bucket{framework=\"scrapling\"})", "legendFormat": "Scrapling P95"},
          {"expr": "histogram_quantile(0.95, firecrawl_api_latency_bucket[5m])", "legendFormat": "Firecrawl P95"},
          {"expr": "histogram_quantile(0.95, scraper_request_duration_seconds_bucket{framework=\"scrapy\"})", "legendFormat": "Scrapy P95"}
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 9,
        "title": "Scrapling - Per Domain Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
        "collapsed": true
      },
      {
        "id": 10,
        "title": "Scrapling: Success Rate by Domain",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "scraper_success_rate_percent{framework=\"scrapling\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {"id": "organize", "options": {"renameByName": {"domain": "Domain", "Value": "Success Rate %"}}}
        ]
      },
      {
        "id": 11,
        "title": "Scrapling: Selector Drift Detection",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 18},
        "targets": [
          {"expr": "sum(scraper_selector_drift_detected{framework=\"scrapling\"})", "legendFormat": "Drift Events"}
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]}
          }
        }
      },
      {
        "id": 12,
        "title": "Scrapling: Proxy Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 22},
        "targets": [
          {"expr": "scraper_proxy_active{framework=\"scrapling\"}", "legendFormat": "Active"},
          {"expr": "scraper_proxy_failed{framework=\"scrapling\"}", "legendFormat": "Failed"}
        ]
      },
      {
        "id": 13,
        "title": "Firecrawl - API Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26},
        "collapsed": true
      },
      {
        "id": 14,
        "title": "Firecrawl: API Calls by Endpoint",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27},
        "targets": [
          {"expr": "rate(firecrawl_api_calls_total{endpoint=\"scrape\"}[5m])", "legendFormat": "Scrape"},
          {"expr": "rate(firecrawl_api_calls_total{endpoint=\"crawl\"}[5m])", "legendFormat": "Crawl"},
          {"expr": "rate(firecrawl_api_calls_total{endpoint=\"agent\"}[5m])", "legendFormat": "Agent"},
          {"expr": "rate(firecrawl_api_calls_total{endpoint=\"search\"}[5m])", "legendFormat": "Search"}
        ]
      },
      {
        "id": 15,
        "title": "Firecrawl: Cost Breakdown by Endpoint",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27},
        "targets": [
          {"expr": "firecrawl_cost_usd_total", "legendFormat": "{{endpoint}}"}
        ]
      },
      {
        "id": 16,
        "title": "Firecrawl: Agent Accuracy",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 35},
        "targets": [
          {"expr": "firecrawl_agent_accuracy", "legendFormat": "Accuracy %"}
        ],
        "thresholds": [
          {"value": 90, "color": "green"},
          {"value": 75, "color": "yellow"},
          {"value": 0, "color": "red"}
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent"
          }
        }
      },
      {
        "id": 17,
        "title": "Firecrawl: Rate Limit Hits",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 35},
        "targets": [
          {"expr": "firecrawl_rate_limits_total", "legendFormat": "Rate Limits"}
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {"mode": "absolute", "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]}
          }
        }
      },
      {
        "id": 18,
        "title": "Scrapy - Crawler Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39},
        "collapsed": true
      },
      {
        "id": 19,
        "title": "Scrapy: Items per Spider",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
        "targets": [
          {"expr": "scrapy_items_scraped_total", "legendFormat": "{{spider}}"}
        ],
        "options": {
          "displayMode": "gradient"
        }
      },
      {
        "id": 20,
        "title": "Scrapy: Error Rate by Spider",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "scrapy_errors_total / scrapy_spider_runs_total * 100",
            "format": "table",
            "instant": true
          }
        ],
        "thresholds": [
          {"color": "green", "value": 0},
          {"color": "yellow", "value": 5},
          {"color": "red", "value": 15}
        ]
      },
      {
        "id": 21,
        "title": "Scrapy: Pipeline Drop Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
        "targets": [
          {"expr": "rate(scrapy_pipeline_dropped_total[5m]) / rate(scrapy_pipeline_processed_total[5m]) * 100", "legendFormat": "{{pipeline}}"}
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 22,
        "title": "Scrapy: Response Status Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
        "targets": [
          {"expr": "scrapy_responses_total", "legendFormat": "{{code}}"}
        ]
      },
      {
        "id": 23,
        "title": "Health Checks",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 56},
        "collapsed": false
      },
      {
        "id": 24,
        "title": "Framework Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 57},
        "targets": [
          {"expr": "scraper_health_status{framework=\"scrapling\"}", "legendFormat": "Scrapling"},
          {"expr": "scraper_health_status{framework=\"firecrawl\"}", "legendFormat": "Firecrawl"},
          {"expr": "scraper_health_status{framework=\"scrapy\"}", "legendFormat": "Scrapy"}
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"color": "red", "text": "Unhealthy"}}, "type": "value"},
              {"options": {"1": {"color": "yellow", "text": "Degraded"}}, "type": "value"},
              {"options": {"2": {"color": "green", "text": "Healthy"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 25,
        "title": "Active Alerts List",
        "type": "alertlist",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 57},
        "options": {
          "showOptions": true,
          "showStates": true,
          "sortOrder": 1
        }
      }
    ],
    "time": {"from": "now-6h", "to": "now"},
    "refresh": "30s",
    "schemaVersion": 38,
    "version": 1
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "framework",
        "type": "custom",
        "options": [
          {"text": "All", "value": ".*"},
          {"text": "Scrapling", "value": "scrapling"},
          {"text": "Firecrawl", "value": "firecrawl"},
          {"text": "Scrapy", "value": "scrapy"}
        ],
        "current": {"text": "All", "value": ".*"}
      },
      {
        "name": "domain",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(scraper_success_rate_percent, domain)"
      }
    ]
  }
}
