#!/bin/bash
# Scrapling CLI Command Wrapper for Qwen Code
# Invokes the Scrapling Python skill with progress tracking
#
# Usage:
#   ./scrape fetch <url> [--dynamic] [--stealth]
#   ./scrape init <project_name>
#   ./scrape status
#   ./scrape test

set -e

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_SCRIPT="$SCRIPT_DIR/../skills/scrapling.py"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Check if Python skill script exists
if [ ! -f "$SKILL_SCRIPT" ]; then
    echo -e "${RED}✗ Error:${NC} Scrapling skill not found at $SKILL_SCRIPT"
    exit 1
fi

# Check if Python is available
if ! command -v python &> /dev/null; then
    echo -e "${RED}✗ Error:${NC} Python is not installed or not in PATH"
    exit 1
fi

# Check if Scrapling is installed
if ! python -c "import scrapling" 2>/dev/null; then
    echo -e "${YELLOW}⚠ Warning:${NC} Scrapling is not installed"
    echo ""
    echo -e "${CYAN}Install with:${NC}"
    echo "  pip install scrapling[all]"
    echo "  scrapling install  # for browser dependencies"
    echo ""
    
    # Ask if user wants to install
    read -p "Would you like to install Scrapling now? (y/n): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        pip install scrapling[all]
        scrapling install
    else
        echo -e "${RED}✗ Cannot proceed without Scrapling${NC}"
        exit 1
    fi
fi

# Forward all arguments to the Python skill script
python "$SKILL_SCRIPT" "$@"

# Show helpful message after command completion
if [ $? -eq 0 ]; then
    echo ""
    echo -e "${CYAN}──────────────────────────────────────${NC}"
    echo -e "${GREEN}✓${NC} Command completed successfully"
    echo -e "${CYAN}──────────────────────────────────────${NC}"
    echo ""
    echo -e "${YELLOW}Tips:${NC}"
    echo "  • Use /scrape in Qwen Code for AI-assisted scraping"
    echo "  • Use @web-scraper-engineer for complex projects"
    echo "  • Run 'python scrapling.py help' for all commands"
fi
