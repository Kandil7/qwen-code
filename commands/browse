#!/usr/bin/env bash
# ~/.qwen/commands/browse - Custom Qwen command for openbrowser
# Usage: /browse "your task description"
#
# This command wraps the openbrowser CLI for easy access within Qwen Code

OPENBROWSER_DIR="$HOME/openbrowser"
CLI_SCRIPT="$OPENBROWSER_DIR/packages/cli/src/index.ts"

# Check if openbrowser is installed
if [ ! -d "$OPENBROWSER_DIR" ]; then
    echo "Error: openbrowser not found at $OPENBROWSER_DIR"
    echo "Please run: git clone https://github.com/ntegrals/openbrowser.git ~/openbrowser"
    exit 1
fi

# Check if dependencies are installed
if [ ! -d "$OPENBROWSER_DIR/node_modules" ]; then
    echo "Installing openbrowser dependencies..."
    cd "$OPENBROWSER_DIR" && bun install
fi

# Run openbrowser with all arguments
cd "$OPENBROWSER_DIR" && bun run "$CLI_SCRIPT" "$@"
